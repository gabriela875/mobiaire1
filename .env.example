# Copie estos valores como variables de entorno (o expórtelos en la terminal).
# Todo tiene valor por defecto; solo cambie lo que necesite.

# API_URL=https://www.datos.gov.co/resource/g4t8-zkc3.json
# API_APP_TOKEN=            # opcional, se pide gratis en datos.gov.co
# ESTACIONES=ciudad bolivar,tunal   # vacío = todas
# FILTRO_SOQL=departamento='BOGOTÁ'
# DIAS_ATRAS=3
# FIREBASE_CREDENCIALES=C:/ruta/fuera/del/repo/clave.json

# FECHA_REFERENCIA=auto     # auto = usa el dato más reciente de la fuente (el dataset actual termina en dic-2024)

# --- WAQI / AQICN (datos recientes de calidad del aire) ---------------------
# Token gratuito de https://aqicn.org/data-platform/token/ (se pide con un correo).
# DEBE vivir SOLO en el backend (este .env). Nunca en JavaScript, HTML ni en el
# repositorio. El frontend llama a nuestros endpoints, no a WAQI directamente.
# WAQI_TOKEN=pega-aqui-tu-token
